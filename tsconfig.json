{
	"compilerOptions": {
		"target": "es2022",
		"outDir": "compiled",

		"module": "nodenext",
		"sourceMap": true,
		"moduleResolution": "nodenext",

		"strict": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"strictNullChecks": true,
		"allowSyntheticDefaultImports": true,

		"types": ["mocha"]
	},

	"include": ["modules", "utils-ts"],
	"exclude": ["utils-ts/modules/tests"]
}
